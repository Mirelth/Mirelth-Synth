{
  "name": "synth-vscode",
  "displayName": "Synth Inspector",
  "description": "Agent 调试与 ReAct 循环可视化（VS Code Inspector Webview）",
  "version": "5.0.0",
  "publisher": "mirelth",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "agent",
    "react-loop",
    "inspector",
    "tool-calls"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:synth.inspect",
    "onCommand:synth.run",
    "onCommand:synth.debug",
    "workspaceContains:.synth.yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "synth.inspect",
        "title": "Synth: Open Inspector",
        "category": "Synth"
      },
      {
        "command": "synth.run",
        "title": "Synth: Run Agent",
        "category": "Synth"
      },
      {
        "command": "synth.debug",
        "title": "Synth: Debug Agent",
        "category": "Synth"
      },
      {
        "command": "synth.stop",
        "title": "Synth: Stop",
        "category": "Synth"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "synth.debug",
          "when": "config.synth.enableDebug"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "yaml"
      }
    ],
    "configuration": {
      "title": "Synth",
      "properties": {
        "synth.enableDebug": {
          "type": "boolean",
          "default": true,
          "description": "Enable Synth debug provider"
        },
        "synth.maxTurns": {
          "type": "number",
          "default": 10,
          "description": "Default max turns when launching an agent run"
        },
        "synth.streamChunkSize": {
          "type": "number",
          "default": 16,
          "description": "Tokens per stream chunk in Inspector view"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}